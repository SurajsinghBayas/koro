# ---- Core ----
PORT=8787
HOST=0.0.0.0
# Local dev: embedded Postgres in ./data/pglite. Production: your Neon *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/koro?sslmode=require
DATABASE_URL=pglite:./data/pglite
DATA_DIR=./data
# Code you type in the app to pair a device (generate one: bun run pair-code)
SETUP_CODE=
APP_TZ=Asia/Kolkata

# ---- Cricket (optional; without keys: free Cricinfo RSS = live totals + results) ----
CRICKETDATA_API_KEY=
CRICKETDATA_DAILY_BUDGET=95
SPORTMONKS_API_TOKEN=
TRACK_INDIA_WOMEN=0

# ---- Push via Firebase Cloud Messaging (optional; without it alerts go to the in-app inbox) ----
# Service account JSON (raw JSON on one line, or a path to the file)
FCM_SERVICE_ACCOUNT_JSON=
# Public app config (Firebase console → Project settings → your Android app)
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# ---- AI (Bedrock Mantle, OpenAI-compatible) ----
AI_API_KEY=
AI_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
AI_MODEL=zai.glm-5
