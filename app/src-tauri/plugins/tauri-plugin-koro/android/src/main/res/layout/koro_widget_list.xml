<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/koro_w_music_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_glow" android:alpha="0.45" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_holo" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_frame" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="✅" android:layout_marginEnd="8dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KORO" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="@color/koro_w_gold" />
                <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="To-do" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/koro_w_text" />
            </LinearLayout>
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/koro_w_pill" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_text" />
        </LinearLayout>
        <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:layout_marginBottom="4dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/koro_w_progress" />
        <LinearLayout android:id="@+id/w_row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check0" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check1" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check2" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check3" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check4" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/koro_w_row"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <ImageView android:id="@+id/w_check5" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/koro_w_check_off" android:contentDescription="Done" />
            <TextView android:id="@+id/w_text5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/koro_w_text" />
            <TextView android:id="@+id/w_meta5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/koro_w_gold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textSize="12sp" android:textColor="@color/koro_w_dim" android:text="" />
    </LinearLayout>
</FrameLayout>
