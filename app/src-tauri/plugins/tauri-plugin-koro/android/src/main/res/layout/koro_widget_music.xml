<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/koro_w_music_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/m_wash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:alpha="0.55" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_holo" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_frame" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <ImageView android:id="@+id/m_art" android:layout_width="84dp" android:layout_height="84dp"
            android:src="@drawable/koro_w_art_empty" android:scaleType="centerCrop" android:contentDescription="Album art" />
        <LinearLayout android:id="@+id/m_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/m_app" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:text="KORO" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="#FFE8C46A" />
                <LinearLayout android:id="@+id/m_src" android:layout_width="wrap_content" android:layout_height="26dp"
                    android:background="@drawable/koro_w_pill" android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:paddingEnd="10dp" android:contentDescription="Switch between phone and Mac">
                    <ImageView android:id="@+id/m_src_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/koro_w_phone" android:contentDescription="@null" />
                    <TextView android:id="@+id/m_src_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                        android:text="Phone" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFF1F5FB" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/m_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="Nothing playing"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
            <TextView android:id="@+id/m_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="#CCFFFFFF" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/m_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                    android:src="@drawable/koro_w_prev" android:contentDescription="Previous" />
                <ImageView android:id="@+id/m_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp"
                    android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                    android:background="@drawable/koro_w_play_bg" android:src="@drawable/koro_w_play" android:contentDescription="Play or pause" />
                <ImageView android:id="@+id/m_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                    android:src="@drawable/koro_w_next" android:contentDescription="Next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
