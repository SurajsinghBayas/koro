<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/koro_w_music_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/ck_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_glow" android:alpha="0.45" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_holo" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_frame" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/ck_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏏" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/ck_live" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/koro_w_live"
                    android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:layout_marginEnd="6dp"
                    android:text="LIVE" android:textSize="9sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:id="@+id/ck_kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT MATCH" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="#FFE8C46A" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/ck_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"
                android:text="No India / MI match" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
            <TextView android:id="@+id/ck_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textSize="12.5sp" android:textStyle="bold" android:textColor="#FFE8C46A" />
            <TextView android:id="@+id/ck_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textColor="#99F1F5FB" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
