{
  "identifier": "default",
  "description": "Koro main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" }, { "url": "http://*/*" }, { "url": "http://*:*" }, { "url": "http://*:*/*" },
        { "url": "https://*" }, { "url": "https://*/*" }, { "url": "https://*:*" }, { "url": "https://*:*/*" }
      ]
    },
    "koro:default"
  ]
}
