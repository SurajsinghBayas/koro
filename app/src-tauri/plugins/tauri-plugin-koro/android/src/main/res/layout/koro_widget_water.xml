<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/koro_w_music_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w2_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_glow" android:alpha="0.45" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_holo" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_frame" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/w2_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/w2_kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 WATER" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="#FFE8C46A" android:maxLines="1" />
        <TextView android:id="@+id/w2_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="0 L" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" />
        <TextView android:id="@+id/w2_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="#99F1F5FB" android:layout_marginTop="2dp" android:maxLines="1"/>
        <ProgressBar android:id="@+id/w2_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="10dp"
            android:layout_marginTop="10dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/koro_w_water_progress" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/w2_add" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/koro_w_btn_gold"
            android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/koro_i_plus" android:tint="#FF1F1500" android:contentDescription="@null" />
            <TextView android:id="@+id/w2_add_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="250 ml" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF1F1500" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
