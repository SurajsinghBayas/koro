<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/koro_w_music_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/t_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/koro_w_glow" android:alpha="0.45" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_holo" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/koro_w_frame" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/t_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:minWidth="96dp">
            <TextView android:id="@+id/t_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="#FFE8C46A" android:maxLines="1" />
            <TextView android:id="@+id/t_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="--°" android:textSize="40sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" />
            <TextView android:id="@+id/t_wx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CCF1F5FB" android:maxLines="1" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/t_hilo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5sp" android:textColor="#99F1F5FB" android:maxLines="1" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:src="#22FFFFFF" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/t_kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KORO · BRIEF" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="#FFE8C46A" android:maxLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="vertical"><TextView android:id="@+id/t_line0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:maxLines="2" android:ellipsize="end" android:textSize="12.5sp" android:lineSpacingExtra="1dp" android:textColor="#E6F1F5FB" /><TextView android:id="@+id/t_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:ellipsize="end" android:textSize="12.5sp" android:lineSpacingExtra="1dp" android:textColor="#E6F1F5FB" /><TextView android:id="@+id/t_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:ellipsize="end" android:textSize="12.5sp" android:lineSpacingExtra="1dp" android:textColor="#E6F1F5FB" /></LinearLayout>
            <TextView android:id="@+id/t_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/koro_w_row"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:maxLines="1" android:ellipsize="end"
                android:textSize="11.5sp" android:textStyle="bold" android:textColor="#FFE8C46A" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
